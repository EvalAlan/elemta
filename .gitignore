# Local configuration files
elemta.toml
# The Kubernetes deployment's config is a tracked template, not a local file.
!deployments/kubernetes/**/elemta.toml
# Generated by make k8s-mailbox-config from config/mailbox-main.toml.
deployments/kubernetes/dev/minimal/mailbox.toml
simple-rspamd.conf
test-rspamd.conf

# Environment and generated config files
.env*
config/*-generated.toml
config/elemta-generated.toml

# Development and debugging scripts
debug-config.sh
fix-*.sh
generate-*.sh
rebuild.sh
restart.sh
working-config.sh

# LDIF files (user data)
*.ldif
!docker/ldap/99-stress-users.ldif
!docker/ldap/10-mail-schema.ldif
local-user*.ldif
change-password.ldif

# Temporary docker files and scripts

# Rspamd overrides: local experiments are ignored, the ones the dev stack
# mounts are tracked. Ignoring the directory itself would stop git descending
# into it, so the contents are ignored instead and the shipped files un-ignored.
docker/rspamd/override.d/*
!docker/rspamd/override.d/*.conf
!docker/rspamd/override.d/options.inc

# Deploy directory
.deploy/

# Additional cruft prevention
config/*.db
config/*.sqlite
*.db-journal
bin/test-*
/elemta
*.prof
*.test
.idea/
.vscode/settings.json
examples/**/*.so
.env
bin/
CLAUDE.md

# Local agent-tool configuration, which is per-machine and never belongs in the
# repo. .codex/config.toml is the one that matters: it stores MCP server
# credentials — a GitHub PAT — as plaintext. Gitleaks only runs in CI, so
# without this it flags the token one push after it has already leaked.
.codex/
.claude/settings.local.json
.claude/worktrees/

# Generated dev service credentials (scripts/dev-secrets.sh)
deployments/compose/.secrets/
deployments/kubernetes/dev/ha/mailbox.toml
deployments/kubernetes/dev/ha/elemta.toml
# One real Linode deployment: settings, generated config and secrets.
deployments/kubernetes/production/linode/instance/

# Copy of the dev server's configuration. Real values: never commit.
.dev-server/
