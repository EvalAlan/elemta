    p993 --> haproxy
    p8027 --> webmail
    p8025 --> web
    p8026 --> rc

    node0 -->|"LMTP 2424"| haproxy
    node0 --> dns
    node0 --> clamav
    node0 --> rspamd
    rspamd --> dns
