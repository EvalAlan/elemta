# Elemta SMTP Server Configuration (TOML format)

# Basic server configuration
hostname = "mail.example.com"
listen_addr = "0.0.0.0:25"
queue_dir = "/var/spool/elemta/queue"
log_level = "info"
max_message_size = 10485760  # 10MB
max_recipients = 100
banner = "Elemta SMTP Server"

# TLS configuration
[tls]
enabled = true
listen_addr = ":465"
cert_file = "/etc/elemta/certs/cert.pem"
key_file = "/etc/elemta/certs/key.pem"
required = false
client_auth = false
min_version = "1.2"
max_version = "1.3"
ciphers = [
  "TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384",
  "TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384",
  "TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305",
  "TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305"
]
enable_starttls = true

# Let's Encrypt configuration
[tls.letsencrypt]
enabled = true
domain = "mail.example.com"
email = "admin@example.com"
cache_dir = "/etc/elemta/certs/letsencrypt"
staging = false

# Certificate renewal configuration
[tls.renewal]
auto_renew = true
renewal_days = 30
check_interval = "24h"
renewal_timeout = "5m"

# Authentication
[auth]
enabled = true
methods = ["plain", "login"]
backend = "file"
file_path = "/etc/elemta/users.json"

# Queue configuration
[queue]
max_workers = 10
max_retries = 5
max_queue_time = 172800  # 2 days
retry_schedule = [60, 300, 900, 3600, 10800, 21600, 43200]  # 1min, 5min, 15min, 1hr, 3hr, 6hr, 12hr
keep_delivered_messages = true
keep_message_data = true
queue_priority_enabled = true

# Plugin configuration
[plugins]
# External .so plugins are listed here. The built-in mail-auth plugins below
# have their own enable switches and do not need a shared-object entry.
enabled = []
directory = "/etc/elemta/plugins"

# Plugin-specific configuration

# SPF verification of the envelope sender. The timeout bounds DNS work done
# while a client waits at end-of-DATA, so a slow resolver cannot become a
# stalled session.
[plugins.spf]
enabled = true
timeout = 10

# DKIM. verify checks arriving mail; sign signs outbound mail on the remote SMTP
# delivery path (not local LMTP delivery), which is what improves deliverability
# to Gmail/Yahoo/Outlook. Publish the matching public key in DNS at
# <selector>._domainkey.<domain>.
#
# Private keys must NOT be readable or writable by group or other:
#   chmod 600 /etc/elemta/dkim/example.com.key
[plugins.dkim]
enabled = true
verify = true
sign = true
# Canonicalization defaults to relaxed/relaxed (recommended). Override with
# "simple" only if you have a specific reason.
header_canonicalization = "relaxed"
body_canonicalization = "relaxed"

  # One block per signing domain. The signing domain is chosen by matching the
  # envelope-from (or, when empty, the From header) domain against these entries.
  [[plugins.dkim.domains]]
  domain = "example.com"
  selector = "mail"
  private_key_path = "/etc/elemta/dkim/example.com.key"
  # headers_to_sign optionally overrides the signed header set. When omitted a
  # sensible default is used (From, To, Cc, Subject, Date, Message-ID,
  # MIME-Version, Content-Type, Reply-To, In-Reply-To, References). A custom
  # list must contain valid RFC 5322 field names and must include From.

# DMARC alignment. enforce is off deliberately: the first thing enforcement does
# on a real server is reject forwarders and mailing lists, which break SPF
# alignment by design. Watch the results in Authentication-Results first.
[plugins.dmarc]
enabled = true
enforce = false
timeout = 10

[plugins.greylisting]
enabled = true
initial_delay = 300
valid_period = 86400
record_expiry = 604800

# Monitoring configuration
[monitoring]
enabled = true
listen_addr = "0.0.0.0:8080"
metrics_path = "/metrics"
health_path = "/health"

# Use remote SMTP delivery for outbound mail. DKIM signing is intentionally not
# applied when mode is "lmtp" because that path is local delivery to Dovecot.
[delivery]
mode = "smtp"

[server]
# session_timeout = "5m"  # Session idle timeout (default: 5m)
