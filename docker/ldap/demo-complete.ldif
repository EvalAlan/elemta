# Elemta demo directory: ten people, distribution lists, forwarding and a
# domain entry, in the current mail schema (docker/ldap/10-mail-schema.ldif).
# The passwords are published demo values: never load this on a server
# anyone else can reach.

# Base organizational structure
dn: dc=example,dc=com
objectClass: top
objectClass: dcObject
objectClass: organization
o: Example Organization
dc: example

dn: ou=people,dc=example,dc=com
objectClass: organizationalUnit
ou: people

dn: ou=groups,dc=example,dc=com
objectClass: organizationalUnit
ou: groups

dn: ou=domains,dc=example,dc=com
objectClass: organizationalUnit
ou: domains

# Domain entry
dn: elemtaDomainName=example.com,ou=domains,dc=example,dc=com
objectClass: elemtaMailDomain
elemtaDomainName: example.com
elemtaCatchAll: demo@example.com
description: The demo domain; unknown addresses go to demo@example.com

# Users - 10 comprehensive test users
# 1. Demo User (main test account)
dn: uid=demo,ou=people,dc=example,dc=com
objectClass: inetOrgPerson
objectClass: posixAccount
objectClass: shadowAccount
objectClass: elemtaMailAccount
uid: demo
cn: Demo User
sn: User
givenName: Demo
mail: demo@example.com
userPassword: demo123
uidNumber: 5001
gidNumber: 5001
homeDirectory: /var/mail/demo@example.com
loginShell: /bin/bash
title: Test Account
departmentNumber: testing
employeeType: test
telephoneNumber: +1-555-0001

# 2. CEO (forwards to assistant)
dn: uid=john.smith,ou=people,dc=example,dc=com
objectClass: inetOrgPerson
objectClass: posixAccount
objectClass: shadowAccount
objectClass: elemtaMailAccount
uid: john.smith
cn: John Smith
sn: Smith
givenName: John
mail: john.smith@example.com
elemtaForwardTo: alice.wilson@example.com
elemtaForwardKeepCopy: TRUE
userPassword: password123
uidNumber: 5002
gidNumber: 5002
homeDirectory: /var/mail/john.smith@example.com
loginShell: /bin/bash
title: Chief Executive Officer
departmentNumber: executive
employeeType: management
telephoneNumber: +1-555-0002

