# Proposed mailbox replicas must expose dependency-aware readiness on :8080.
global
    log stdout format raw local0
    maxconn 512

defaults
    mode tcp
    log global
    timeout connect 3s
    timeout client 35m
    timeout server 35m

resolvers docker
    nameserver dns 127.0.0.11:53
    resolve_retries 3
    timeout resolve 1s
    timeout retry 1s
    hold valid 10s

frontend imap
    bind :1143
    default_backend imap_nodes

backend imap_nodes
    balance leastconn
    option httpchk
    http-check send meth GET uri /readyz
    http-check expect status 200
    server a mailbox-a:1143 check port 8080 inter 2s fall 2 rise 2 resolvers docker init-addr libc,none
    server b mailbox-b:1143 check port 8080 inter 2s fall 2 rise 2 resolvers docker init-addr libc,none

frontend lmtp
    bind :2424
    default_backend lmtp_nodes

backend lmtp_nodes
    balance leastconn
    option httpchk
    http-check send meth GET uri /readyz
    http-check expect status 200
    server a mailbox-a:2424 check port 8080 inter 2s fall 2 rise 2 resolvers docker init-addr libc,none
    server b mailbox-b:2424 check port 8080 inter 2s fall 2 rise 2 resolvers docker init-addr libc,none
