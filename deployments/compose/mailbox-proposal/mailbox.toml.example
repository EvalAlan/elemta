# Proposed configuration contract. No Go decoder consumes these fields yet.
# This file describes the daily development topology, not production settings.

[server]
imap_listen = ":1143"
lmtp_listen = ":2424"
http_listen = ":8080"
allow_plaintext_auth = true

[metadata]
driver = "postgres"
# The proposed connector reads PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD.
use_pg_environment = true
max_connections = 8

[bodies]
driver = "file"
root = "/var/lib/elemta/bodies"
verify_checksums = true

[auth]
# Same account/password directory as the running development stack. Anonymous
# lookup must not be assumed; LDAP service credentials still need provisioning.
ldap_url = "ldap://elemta-ldap:389"
ldap_base = "ou=people,dc=example,dc=com"
ldap_user_filter = "(&(objectClass=posixAccount)(mail=%s))"
ldap_bind_dn_env = "ELEMTA_MAILBOX_LDAP_DN"
ldap_bind_password_env = "ELEMTA_MAILBOX_LDAP_PASSWORD"

[workers]
search = true
outbox = true
garbage_collection = true

[limits]
max_connections = 256
max_message_mb = 50
