# One Elemta deployment on Linode. `make linode-init` copies this file to
# ../instance/settings.env, which git ignores: fill in the real values
# there, never here. `make linode-config` builds the deployment from it and
# `make linode-check` refuses any example value left over.

# The domain users have addresses in, and the names clients use. DNS:
# MAIL_HOST is the MX target and points at the elemta-mail-public
# NodeBalancer; ADMIN_HOST and WEBMAIL_HOST point at HAProxy's. The
# IMAP/POP3/Sieve NodeBalancer (elemta-mailbox-public) needs a name of its
# own, or the same name if both share a reserved address (README.md).
MAIL_DOMAIN=example.com
MAIL_HOST=mail.example.com
ADMIN_HOST=admin.example.com
WEBMAIL_HOST=webmail.example.com

# Let's Encrypt's contact for certificate expiry notices.
ACME_EMAIL=postmaster@example.com

# The mailbox password-reset mail is sent from. Its password goes in
# secrets/recovery-smtp.env.
RECOVERY_SENDER=no-reply@example.com

# A release tag (v0.5.3) or full commit SHA published to GHCR.
IMAGE_TAG=v0.0.0

# LKE's pod network: kubectl get nodes -o jsonpath='{.items[*].spec.podCIDR}'
# shows a slice of it per node. Trusted to deliver over LMTP, and as the
# HTTPS ingress in front of admin and webmail.
POD_CIDR=10.2.0.0/16

# Where NodeBalancers connect to the nodes from, and so where a PROXY
# protocol header is believed. 192.168.255.0/24 is shared by every
# NodeBalancer in the data center; with VPC backends use the VPC range you
# set aside for them instead (README.md, "Client addresses").
PROXY_PROTOCOL_FROM=192.168.255.0/24

# A StorageClass providing ReadWriteMany (README.md, "Storage").
RWX_STORAGE_CLASS=longhorn

# Linode Object Storage for message bodies. Keys go in secrets/s3.env.
S3_ENDPOINT=us-east-1.linodeobjects.com
S3_REGION=us-east-1
S3_BUCKET=elemta-mail-example
