# Public HTTPS for the cloud dev server (docs/cloud-dev.md). Caddy obtains and
# renews the Let's Encrypt certificate for MAIL_DOMAIN; the mail services use
# the same certificate, copied out by scripts/cloud-sync-certs.sh. No ACME
# contact address: Let's Encrypt no longer sends expiry mail; the admin
# console's Health page shows the certificate's expiry.

{$MAIL_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}

	# Thunderbird's autoconfig. The mail domain is this host, so the
	# well-known path on it is found without an autoconfig.<domain> record.
	@autoconfig path /.well-known/autoconfig/mail/config-v1.1.xml /mail/config-v1.1.xml
	handle @autoconfig {
		header Content-Type "application/xml; charset=utf-8"
		respond <<XML
			<?xml version="1.0" encoding="UTF-8"?>
			<clientConfig version="1.1">
			  <emailProvider id="{$MAIL_DOMAIN}">
			    <domain>{$MAIL_DOMAIN}</domain>
			    <displayName>Elemta ({$MAIL_DOMAIN})</displayName>
			    <displayShortName>Elemta</displayShortName>
			    <incomingServer type="imap">
			      <hostname>{$MAIL_DOMAIN}</hostname>
			      <port>993</port>
			      <socketType>SSL</socketType>
			      <authentication>password-cleartext</authentication>
			      <username>%EMAILADDRESS%</username>
			    </incomingServer>
			    <outgoingServer type="smtp">
			      <hostname>{$MAIL_DOMAIN}</hostname>
			      <port>587</port>
			      <socketType>STARTTLS</socketType>
			      <authentication>password-cleartext</authentication>
			      <username>%EMAILADDRESS%</username>
			    </outgoingServer>
			  </emailProvider>
			</clientConfig>
			XML 200
	}

	handle {
		reverse_proxy elemta-webmail:8027
	}
}
