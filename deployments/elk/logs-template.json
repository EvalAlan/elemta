{
  "index_patterns": [
    "elemta-logs-*"
  ],
  "priority": 511,
  "_meta": {
    "description": "Elemta service logs"
  },
  "template": {
    "settings": {
      "index": {
        "auto_expand_replicas": "0-1",
        "mapping": {
          "total_fields": {
            "ignore_dynamic_beyond_limit": true,
            "limit": 2000
          }
        }
      }
    },
    "mappings": {
      "dynamic": false,
      "dynamic_templates": [
        {
          "elemta_keys": {
            "mapping": {
              "ignore_above": 4096,
              "type": "keyword"
            },
            "path_match": "elemta.*"
          }
        }
      ],
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "client": {
          "properties": {
            "as": {
              "properties": {
                "number": {
                  "type": "long"
                },
                "organization": {
                  "properties": {
                    "name": {
                      "fields": {
                        "text": {
                          "type": "match_only_text"
                        }
                      },
                      "ignore_above": 1024,
                      "type": "keyword"
                    }
                  }
                }
              }
            },
            "domain": {
              "ignore_above": 1024,
              "type": "keyword"
            },
            "geo": {
              "properties": {
                "city_name": {
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "continent_name": {
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "country_iso_code": {
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "country_name": {
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "location": {
                  "type": "geo_point"
                },
                "region_iso_code": {
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "region_name": {
                  "ignore_above": 1024,
                  "type": "keyword"
                }
              }
            },
            "ip": {
              "ignore_malformed": true,
              "type": "ip"
            }
          }
        },
        "elemta": {
          "dynamic": true,
          "subobjects": false,
          "type": "object"
        },
        "email": {
          "properties": {
            "local_id": {
              "ignore_above": 1024,
              "type": "keyword"
            },
            "message_id": {
              "ignore_above": 1024,
              "type": "keyword"
            }
          }
        },
        "event": {
          "properties": {
            "action": {
              "ignore_above": 1024,
              "type": "keyword"
            },
            "duration": {
              "ignore_malformed": true,
              "type": "long"
            },
            "outcome": {
              "ignore_above": 1024,
              "type": "keyword"
            },
            "reason": {
              "ignore_above": 1024,
              "type": "keyword"
            }
          }
        },
        "host": {
          "properties": {
            "name": {
              "ignore_above": 1024,
              "type": "keyword"
            }
          }
        },
        "log": {
          "properties": {
            "level": {
              "ignore_above": 1024,
              "type": "keyword"
            }
          }
        },
        "mail": {
          "properties": {
            "recipient_count": {
              "ignore_malformed": true,
              "type": "integer"
            },
            "response_code": {
              "ignore_malformed": true,
              "type": "short"
            },
            "response_status": {
              "ignore_above": 1024,
              "type": "keyword"
            },
            "size": {
              "ignore_malformed": true,
              "type": "long"
            },
            "spam_score": {
              "ignore_malformed": true,
              "type": "float"
            }
          }
        },
        "message": {
          "fields": {
            "keyword": {
              "ignore_above": 512,
              "type": "keyword"
            }
          },
          "type": "text"
        },
        "network": {
          "properties": {
            "protocol": {
              "ignore_above": 1024,
              "type": "keyword"
            }
          }
        },
        "service": {
          "properties": {
            "name": {
              "ignore_above": 1024,
              "type": "keyword"
            }
          }
        },
        "source": {
          "properties": {
            "as": {
              "properties": {
                "number": {
                  "type": "long"
                },
                "organization": {
                  "properties": {
                    "name": {
                      "fields": {
                        "text": {
                          "type": "match_only_text"
                        }
                      },
                      "ignore_above": 1024,
                      "type": "keyword"
                    }
                  }
                }
              }
            },
            "domain": {
              "ignore_above": 1024,
              "type": "keyword"
            },
            "geo": {
              "properties": {
                "city_name": {
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "continent_name": {
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "country_iso_code": {
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "country_name": {
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "location": {
                  "type": "geo_point"
                },
                "region_iso_code": {
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "region_name": {
                  "ignore_above": 1024,
                  "type": "keyword"
                }
              }
            },
            "ip": {
              "ignore_malformed": true,
              "type": "ip"
            }
          }
        },
        "tls": {
          "properties": {
            "established": {
              "type": "boolean"
            }
          }
        },
        "user": {
          "properties": {
            "name": {
              "ignore_above": 1024,
              "type": "keyword"
            }
          }
        }
      }
    }
  }
}
